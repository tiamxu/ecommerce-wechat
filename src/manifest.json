{
  "name": "ecommerce-wechat",
  "appid": "wx51adb06f586c8ac0", 
  "description": "智能旅行小程序",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
    "appid": "wx51adb06f586c8ac0",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "获取用户位置信息用于附近门店"
      }
    },
    "requiredPrivateInfos": ["getLocation"]
  },
  "h5": {
    "devServer": {
      "port": 5173,
      "disableHostCheck": true,
      "proxy": {
        "/api": {
          "target": "http://localhost:8080",
          "changeOrigin": true
        },
        "/public": {
          "target": "http://localhost:8080",
          "changeOrigin": true
        },
        "/cart": {
          "target": "http://localhost:8080",
          "changeOrigin": true
        },
        "/order": {
          "target": "http://localhost:8080",
          "changeOrigin": true
        }
      }
    },
    "router": {
      "mode": "hash"
    }
  }
}
