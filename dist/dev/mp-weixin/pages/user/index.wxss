.user-page.data-v-642c545b {
  min-height: 100vh;
  background: var(--bg-page);
}
.user-header.data-v-642c545b {
  padding: 60rpx 32rpx;
  background: var(--bg-card);
  margin-bottom: 24rpx;
}
.user-info.data-v-642c545b, .login-prompt.data-v-642c545b {
  display: flex;
  align-items: center;
}
.avatar.data-v-642c545b {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
}
.avatar-img.data-v-642c545b {
  width: 100%;
  height: 100%;
}
.login-avatar.data-v-642c545b {
  background: var(--border);
}
.avatar-text.data-v-642c545b {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
}
.user-detail.data-v-642c545b {
  display: flex;
  flex-direction: column;
}
.nickname.data-v-642c545b {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}
.phone.data-v-642c545b {
  font-size: 24rpx;
  color: var(--text-sub);
}
.login-text.data-v-642c545b {
  font-size: 32rpx;
  color: var(--primary);
}
.menu-section.data-v-642c545b {
  background: var(--bg-card);
  margin-bottom: 24rpx;
}
.menu-item.data-v-642c545b {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}
.menu-item.data-v-642c545b:last-child {
  border-bottom: none;
}
.menu-item.data-v-642c545b:active {
  background: var(--bg-page);
}
.menu-icon.data-v-642c545b {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.menu-text.data-v-642c545b {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}
.menu-arrow.data-v-642c545b {
  font-size: 28rpx;
  color: var(--text-placeholder);
}
.logout-section.data-v-642c545b {
  padding: 32rpx;
}
.logout-btn.data-v-642c545b {
  display: block;
  width: 100%;
  padding: 24rpx;
  background: var(--bg-card);
  color: var(--text-sub);
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.logout-btn.data-v-642c545b:active {
  opacity: 0.8;
}