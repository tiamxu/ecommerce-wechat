.cart-page.data-v-3277fd7b {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 140rpx;
}
.empty-cart.data-v-3277fd7b {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.empty-icon.data-v-3277fd7b {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}
.empty-text.data-v-3277fd7b {
  font-size: 32rpx;
  color: var(--text-sub);
  margin-bottom: 32rpx;
}
.empty-btn.data-v-3277fd7b {
  padding: 20rpx 48rpx;
  background: var(--primary);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.cart-content.data-v-3277fd7b {
  padding: 24rpx;
}
.cart-list.data-v-3277fd7b {
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
}
.cart-item.data-v-3277fd7b {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border);
}
.cart-item.data-v-3277fd7b:last-child {
  border-bottom: none;
}
.item-checkbox.data-v-3277fd7b, .checkbox.data-v-3277fd7b {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--border);
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.item-checkbox.selected.data-v-3277fd7b, .checkbox.selected.data-v-3277fd7b {
  background: var(--primary);
  border-color: var(--primary);
}
.item-checkbox.selected.data-v-3277fd7b::after, .checkbox.selected.data-v-3277fd7b::after {
  content: "✓";
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}
.item-img.data-v-3277fd7b {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.cover-img.data-v-3277fd7b {
  width: 100%;
  height: 100%;
}
.placeholder-text.data-v-3277fd7b {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.6);
}
.item-info.data-v-3277fd7b {
  flex: 1;
  min-width: 0;
}
.item-name.data-v-3277fd7b {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-price.data-v-3277fd7b {
  display: block;
  font-size: 28rpx;
  color: var(--price);
  font-weight: 600;
}
.item-control.data-v-3277fd7b {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.qty-btn.data-v-3277fd7b {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}
.qty-btn.data-v-3277fd7b:active {
  background: var(--border);
}
.qty-value.data-v-3277fd7b {
  width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-main);
}
.delete-btn.data-v-3277fd7b {
  font-size: 40rpx;
  color: var(--text-placeholder);
  padding: 8rpx;
  flex-shrink: 0;
}
.cart-footer.data-v-3277fd7b {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}
.select-all.data-v-3277fd7b {
  display: flex;
  align-items: center;
}
.select-text.data-v-3277fd7b {
  font-size: 28rpx;
  color: var(--text-main);
  margin-left: 12rpx;
}
.total-section.data-v-3277fd7b {
  flex: 1;
  text-align: right;
  margin-right: 24rpx;
}
.total-label.data-v-3277fd7b {
  font-size: 24rpx;
  color: var(--text-sub);
}
.total-price.data-v-3277fd7b {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--price);
}
.checkout-btn.data-v-3277fd7b {
  padding: 24rpx 48rpx;
  background: var(--primary);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}