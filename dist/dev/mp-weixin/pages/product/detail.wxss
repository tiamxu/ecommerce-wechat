.product-detail.data-v-8216645a {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 140rpx;
}
.detail-swiper.data-v-8216645a {
  width: 100%;
  height: 750rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
}
.cover-image.data-v-8216645a {
  width: 100%;
  height: 100%;
}
.img-placeholder.data-v-8216645a {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text.data-v-8216645a {
  font-size: 120rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.6);
}
.detail-info.data-v-8216645a {
  padding: 32rpx;
  background: var(--bg-card);
  margin-bottom: 24rpx;
}
.info-header.data-v-8216645a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.product-price.data-v-8216645a {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--price);
}
.product-stock.data-v-8216645a {
  font-size: 24rpx;
  color: var(--text-sub);
}
.product-name.data-v-8216645a {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}
.product-desc.data-v-8216645a {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.6;
}
.detail-tags.data-v-8216645a {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  margin-bottom: 24rpx;
}
.tag.data-v-8216645a {
  padding: 8rpx 24rpx;
  background: var(--bg-page);
  border: 1rpx solid var(--border);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
.action-bar.data-v-8216645a {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}
.quantity.data-v-8216645a {
  display: flex;
  align-items: center;
}
.qty-label.data-v-8216645a {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-right: 16rpx;
}
.qty-control.data-v-8216645a {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  border-radius: 8rpx;
}
.qty-btn.data-v-8216645a {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
}
.qty-btn.data-v-8216645a:active {
  background: var(--border);
}
.qty-value.data-v-8216645a {
  width: 72rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}
.action-buttons.data-v-8216645a {
  display: flex;
  gap: 20rpx;
}
.btn-add.data-v-8216645a, .btn-buy.data-v-8216645a {
  padding: 20rpx 36rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-add.data-v-8216645a {
  background: var(--accent);
  color: var(--text-inverse);
}
.btn-buy.data-v-8216645a {
  background: var(--primary);
  color: var(--text-inverse);
}