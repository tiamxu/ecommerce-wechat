.product-list.data-v-c68fff60 {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}
.search-bar.data-v-c68fff60 {
  height: 96rpx;
  padding: 16rpx 24rpx;
  background: var(--primary);
  flex-shrink: 0;
}
.search-input-wrap.data-v-c68fff60 {
  height: 64rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.search-placeholder.data-v-c68fff60 {
  color: var(--text-placeholder);
  font-size: 26rpx;
  margin-left: 8rpx;
}
.category-nav.data-v-c68fff60 {
  height: 88rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  white-space: nowrap;
  flex-shrink: 0;
}
.category-list.data-v-c68fff60 {
  display: inline-flex;
  padding: 0 16rpx;
  gap: 16rpx;
  height: 88rpx;
  align-items: center;
}
.category-item.data-v-c68fff60 {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: var(--bg-page);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}
.category-item.active.data-v-c68fff60 {
  background: var(--primary);
  color: var(--text-inverse);
  font-weight: 600;
}
.category-text.data-v-c68fff60 {
  font-size: 28rpx;
}
.product-scroll.data-v-c68fff60 {
  flex: 1;
  overflow-y: auto;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.product-grid.data-v-c68fff60 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 24rpx;
}
.loading-tip.data-v-c68fff60 {
  padding: 32rpx;
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
}
.skeleton-grid.data-v-c68fff60 {
  padding: 24rpx;
}
.skeleton-card.data-v-c68fff60 {
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
}
.skeleton-info.data-v-c68fff60 {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}