.product-list.data-v-c68fff60 {
  min-height: 100vh;
  background: var(--bg-page);
}
.category-scroll.data-v-c68fff60 {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg-card);
  white-space: nowrap;
  padding: 24rpx 0;
}
.category-list.data-v-c68fff60 {
  display: inline-flex;
  padding: 0 16rpx;
  gap: 16rpx;
}
.category-item.data-v-c68fff60 {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: var(--bg-page);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  transition: all 0.3s;
}
.category-item.active.data-v-c68fff60 {
  background: var(--primary);
  color: #ffffff;
}
.category-text.data-v-c68fff60 {
  font-size: 28rpx;
}
.product-grid.data-v-c68fff60 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 24rpx;
}
.loading-tip.data-v-c68fff60 {
  padding: 32rpx;
  text-align: center;
}
.loading-text.data-v-c68fff60 {
  font-size: 28rpx;
  color: var(--text-sub);
}