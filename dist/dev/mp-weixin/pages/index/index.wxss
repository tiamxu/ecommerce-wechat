.home.data-v-83a5a03c {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 搜索栏 */
.search-bar.data-v-83a5a03c {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  padding-top: calc(12rpx + env(safe-area-inset-top));
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
}
.search-input-wrap.data-v-83a5a03c {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
}
.search-placeholder.data-v-83a5a03c {
  font-size: 28rpx;
  color: var(--text-placeholder);
  margin-left: 8rpx;
}

/* Banner */
.banner.data-v-83a5a03c {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}
.banner-swiper.data-v-83a5a03c {
  width: 100%;
  height: 380rpx;
}
.banner-item.data-v-83a5a03c {
  width: 100%;
  height: 380rpx;
  background-size: cover;
  background-position: center;
  position: relative;
}
.banner-overlay.data-v-83a5a03c {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 100%);
}
.banner-1.data-v-83a5a03c {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
}
.banner-2.data-v-83a5a03c {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 100%);
}
.banner-content.data-v-83a5a03c {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 32rpx;
  padding: 0 32rpx;
  z-index: 1;
}
.banner-title.data-v-83a5a03c {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}
.banner-desc.data-v-83a5a03c {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
}

/* 热门推荐 */
.section.data-v-83a5a03c {
  padding: 32rpx 24rpx;
  background: var(--bg-card);
  margin: 24rpx;
  border-radius: 16rpx;
}
.section-header.data-v-83a5a03c {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}
.section-title-wrap.data-v-83a5a03c {
  display: flex;
  flex-direction: column;
}
.section-title.data-v-83a5a03c {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}
.section-subtitle.data-v-83a5a03c {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.section-more.data-v-83a5a03c {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--primary);
}
.more-arrow.data-v-83a5a03c {
  font-size: 28rpx;
  margin-left: 4rpx;
}
.product-grid.data-v-83a5a03c {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.product-card.data-v-83a5a03c {
  background: var(--bg-page);
  border-radius: 16rpx;
  overflow: hidden;
}
.card-img-wrap.data-v-83a5a03c {
  position: relative;
  height: 320rpx;
}
.card-img.data-v-83a5a03c {
  width: 100%;
  height: 100%;
}
.card-img-placeholder.data-v-83a5a03c {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text.data-v-83a5a03c {
  font-size: 64rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.6);
}
.card-tag.data-v-83a5a03c {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  background: var(--accent);
  color: var(--text-inverse);
  font-size: 20rpx;
  border-radius: 20rpx;
}
.card-info.data-v-83a5a03c {
  padding: 16rpx;
}
.card-info.data-v-83a5a03c .skeleton {
  margin-bottom: 12rpx;
}
.card-name.data-v-83a5a03c {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-bottom.data-v-83a5a03c {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-price.data-v-83a5a03c {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price);
}
.card-sales.data-v-83a5a03c {
  font-size: 22rpx;
  color: var(--text-sub);
}
.empty-tip.data-v-83a5a03c {
  text-align: center;
  padding: 48rpx;
  color: var(--text-sub);
}