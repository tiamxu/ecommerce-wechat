.order-list.data-v-80f8e5f8 {
  min-height: 100vh;
  background: var(--bg-page);
}
.tab-scroll.data-v-80f8e5f8 {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg-card);
}
.tab-list.data-v-80f8e5f8 {
  display: flex;
  padding: 0 16rpx;
}
.tab-item.data-v-80f8e5f8 {
  padding: 24rpx 32rpx;
  position: relative;
}
.tab-item.active.data-v-80f8e5f8::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}
.tab-item.active .tab-text.data-v-80f8e5f8 {
  color: var(--primary);
  font-weight: 600;
}
.tab-text.data-v-80f8e5f8 {
  font-size: 28rpx;
  color: var(--text-sub);
}
.order-content.data-v-80f8e5f8 {
  padding: 24rpx;
}
.loading-tip.data-v-80f8e5f8 {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-sub);
}
.empty-tip.data-v-80f8e5f8 {
  padding: 120rpx 0;
  text-align: center;
}
.empty-text.data-v-80f8e5f8 {
