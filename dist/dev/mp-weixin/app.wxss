/* 主题系统 V3 - 统一可配置主题样式 */

/* 浅色主题 */
.theme-light {
  --primary: #07c160;
  --primary-hover: #10b365;
  --primary-light: #e8f6ef;
  --accent: #ff6034;
  --accent-hover: #ff7d5a;
  --accent-light: #fff0ed;
  --price: #ff4d4f;
  --bg-page: #f8fff9;
  --bg-card: #ffffff;
  --bg-header: #ffffff;
  --bg-input: #f5f5f5;
  --text-main: #1a1a1a;
  --text-sub: #666666;
  --text-placeholder: #999999;
  --text-inverse: #ffffff;
  --border: #e8f5ec;
  --shadow: rgba(7, 193, 96, 0.08);
  --tab-bar-bg: #ffffff;
  --tab-bar-color: #999999;
  --tab-bar-active: #07c160;
}

/* 深色主题 */
.theme-dark {
  --primary: #4d7cff;
  --primary-hover: #6b99ff;
  --primary-light: #2a3a5c;
  --accent: #ff7d41;
  --accent-hover: #ff9d6b;
  --accent-light: #3d2a1a;
  --price: #ff6b6b;
  --bg-page: #1a1a1a;
  --bg-card: #2a2a2a;
  --bg-header: #2a2a2a;
  --bg-input: #3a3a3a;
  --text-main: #ffffff;
  --text-sub: #a0a0a0;
  --text-placeholder: #666666;
  --text-inverse: #1a1a1a;
  --border: #3a3a3a;
  --shadow: rgba(0, 0, 0, 0.3);
  --tab-bar-bg: #2a2a2a;
  --tab-bar-color: #666666;
  --tab-bar-active: #4d7cff;
}

/* 商务蓝主题 */
.theme-blue {
  --primary: #007aff;
  --primary-hover: #3395ff;
  --primary-light: #e5f0ff;
  --accent: #c9a961;
  --accent-hover: #d4b87a;
  --accent-light: #faf6ee;
  --price: #007aff;
  --bg-page: #f5f5f7;
  --bg-card: #ffffff;
  --bg-header: #ffffff;
  --bg-input: #f5f5f7;
  --text-main: #1a1a1a;
  --text-sub: #666666;
  --text-placeholder: #999999;
  --text-inverse: #ffffff;
  --border: #e5e5ea;
  --shadow: rgba(0, 0, 0, 0.06);
  --tab-bar-bg: #ffffff;
  --tab-bar-color: #999999;
  --tab-bar-active: #007aff;
}

/* 优雅紫主题 */
.theme-purple {
  --primary: #667eea;
  --primary-hover: #8595f3;
  --primary-light: #ede7ff;
  --accent: #e8917a;
  --accent-hover: #f0a898;
  --accent-light: #fdf2ef;
  --price: #667eea;
  --bg-page: #f5f5f7;
  --bg-card: #ffffff;
  --bg-header: #ffffff;
  --bg-input: #f5f5f7;
  --text-main: #1a1a1a;
  --text-sub: #666666;
  --text-placeholder: #999999;
  --text-inverse: #ffffff;
  --border: #e5e5ea;
  --shadow: rgba(102, 126, 234, 0.08);
  --tab-bar-bg: #ffffff;
  --tab-bar-color: #999999;
  --tab-bar-active: #667eea;
}

/* 轻奢主题 */
.theme-luxury {
  --primary: #c9a961;
  --primary-hover: #d4b872;
  --primary-light: #2a2a1a;
  --accent: #d4af37;
  --accent-hover: #e5c76b;
  --accent-light: #2a2a1a;
  --price: #c9a961;
  --bg-page: #0f0f0f;
  --bg-card: #1a1a1a;
  --bg-header: #1a1a1a;
  --bg-input: #2a2a2a;
  --text-main: #f5f5f5;
  --text-sub: #a0a0a0;
  --text-placeholder: #666666;
  --text-inverse: #0f0f0f;
  --border: #3a3a3a;
  --shadow: rgba(201, 169, 97, 0.15);
  --tab-bar-bg: #1a1a1a;
  --tab-bar-color: #666666;
  --tab-bar-active: #c9a961;
}

/* 默认页面样式（浅色主题） */
page {
  --primary: #07c160;
  --primary-hover: #10b365;
  --primary-light: #e8f6ef;
  --accent: #ff6034;
  --accent-hover: #ff7d5a;
  --accent-light: #fff0ed;
  --price: #ff4d4f;
  --bg-page: #f8fff9;
  --bg-card: #ffffff;
  --bg-header: #ffffff;
  --bg-input: #f5f5f5;
  --text-main: #1a1a1a;
  --text-sub: #666666;
  --text-placeholder: #999999;
  --text-inverse: #ffffff;
  --border: #e8f5ec;
  --shadow: rgba(7, 193, 96, 0.08);
  --tab-bar-bg: #ffffff;
  --tab-bar-color: #999999;
  --tab-bar-active: #07c160;

  background-color: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.6;
}
view, text {
  box-sizing: border-box;
}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}