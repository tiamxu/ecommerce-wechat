.product-card.data-v-a4cce9c2 {
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx var(--shadow);
  transition: all 0.3s;
}
.product-card.data-v-a4cce9c2:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.card-img.data-v-a4cce9c2 {
  position: relative;
  height: 340rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
}
.cover-img.data-v-a4cce9c2 {
  width: 100%;
  height: 100%;
  transition: opacity 0.3s;
}
.img-placeholder.data-v-a4cce9c2 {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text.data-v-a4cce9c2 {
  font-size: 80rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.6);
}
.card-tag.data-v-a4cce9c2 {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 16rpx;
  background: var(--accent);
  color: var(--text-inverse);
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 24rpx;
}
.card-info.data-v-a4cce9c2 {
  padding: 20rpx;
}
.product-name.data-v-a4cce9c2 {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 78rpx;
}
.price-row.data-v-a4cce9c2 {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.product-price.data-v-a4cce9c2 {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--price);
}
.original-price.data-v-a4cce9c2 {
  font-size: 24rpx;
  color: var(--text-placeholder);
  text-decoration: line-through;
}
.info-bottom.data-v-a4cce9c2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sales-count.data-v-a4cce9c2 {
  font-size: 22rpx;
  color: var(--text-sub);
}
.stock-tip.data-v-a4cce9c2 {
  font-size: 20rpx;
  font-weight: 500;
}
.stock-tip.low.data-v-a4cce9c2 {
  color: var(--accent);
}
.stock-tip.out.data-v-a4cce9c2 {
  color: var(--text-placeholder);
  background: var(--bg-page);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.product-card.stock-out .cover-img.data-v-a4cce9c2 {
  opacity: 0.6;
}